# Copy to .env.production on the server and fill in.
APP_URL="https://lor.example.com"        # or http://<server-ip>
APP_SECRET="<run: openssl rand -hex 32>"
APP_PASSWORD="<access password for the site>"   # remove once Entra ID SSO is added
ORG_NAME="Khalifa University"
SEED_DEMO=1                              # load demo audits on first start (only if DB is empty); set 0 for a clean start

ANTHROPIC_API_KEY=""

MICROSOFT_APP_ID=""
MICROSOFT_APP_PASSWORD=""
MICROSOFT_APP_TYPE="SingleTenant"
MICROSOFT_APP_TENANT_ID=""
TEAMS_WEBHOOK_URL=""

CRON_SECRET="<run: openssl rand -hex 24>"
