# ---- Core ----
DATABASE_URL="file:./dev.db"            # production: postgresql://... (and set provider = "postgresql" in prisma/schema.prisma)
APP_URL="http://localhost:3000"         # public URL — used in Teams card links
APP_SECRET="generate-a-long-random-string"  # signs the one-click review links in Teams cards
ORG_NAME="Khalifa University"           # shown in the header
STORAGE_DIR="./storage"                 # evidence repository (swap src/lib/storage.ts for Azure Blob / SharePoint)
# APP_TODAY="2026-10-19"                # demo only: pin "today"

# ---- AI agents (Claude) ----
ANTHROPIC_API_KEY=""                    # without it the app uses rule-based fallbacks
# CLAUDE_MODEL="claude-opus-5-5"

# ---- Teams option A: bot (interactive approve/reject inside the card) ----
MICROSOFT_APP_ID=""
MICROSOFT_APP_PASSWORD=""
MICROSOFT_APP_TYPE="SingleTenant"
MICROSOFT_APP_TENANT_ID=""

# ---- Teams option B: channel webhook (cards with "Review & decide" link) ----
TEAMS_WEBHOOK_URL=""

# ---- Scheduler ----
CRON_SECRET=""                          # GET /api/cron/followup with "Authorization: Bearer <CRON_SECRET>"
